{
  "name": "recon-agent-private-inventory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@aws-sdk/client-route-53": "^3.1178.0",
    "@google-cloud/dns": "^6.3.0",
    "dotenv": "^16.4.7",
    "express": "^5.3.0"
  }
}
