# Cloudflare API token with Zone:Read and DNS:Read access only.
CLOUDFLARE_API_TOKEN=

# AWS SDK default credential chain. Grant route53:ListHostedZones and
# route53:ListResourceRecordSets only. Configure credentials outside this file.
AWS_REGION=us-east-1

# Google Application Default Credentials path and project ID with DNS read access.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# The local API binds only to loopback.
API_PORT=3001
